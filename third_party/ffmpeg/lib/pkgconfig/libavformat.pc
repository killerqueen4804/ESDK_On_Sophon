prefix=/data/Edge-SDK/third_party/ffmpeg/
exec_prefix=${prefix}
libdir=/data/Edge-SDK/third_party/ffmpeg//lib
includedir=/data/Edge-SDK/third_party/ffmpeg//include

Name: libavformat
Description: FFmpeg container format library
Version: 58.20.100
Requires: 
Requires.private: libavcodec >= 58.35.100, libswresample >= 3.3.100, libavutil >= 56.22.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm -lz
Cflags: -I${includedir}
